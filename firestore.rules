rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: cuenta con email verificado. El PIN de la app es solo la puerta visual; el permiso real es este.
    function esAdmin() {
      return request.auth != null
          && request.auth.token.email == 'rgaraventa@gmail.com'
          && request.auth.token.email_verified == true;
    }

    // ===== CUENTAS =====
    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // Alta: solo la propia cuenta, siempre en estado demo y con vencimiento de hasta ~14 días (margen por reloj del teléfono)
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'nombre', 'estado', 'vence', 'creado'])
                    && request.resource.data.estado == 'demo'
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.vence is number
                    && request.resource.data.vence <= request.time.toMillis() + 15 * 86400000;

      // Estado, vencimiento, pagos y notas: SOLO el administrador. El usuario puede cambiar únicamente su nombre.
      allow update: if esAdmin()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']));
      allow delete: if false;

      // Copia de datos del usuario en la nube
      match /registros/{rid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Pagos registrados a mano por el administrador
      match /pagos/{pid} {
        allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
        allow write: if esAdmin();
      }
    }

    // ===== FLOTAS (plan flota: el dueño ve a sus choferes) =====
    match /flotas/{flotaId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.limiteChoferes == 2;
      allow update: if request.auth != null && (
          (resource.data.owner == request.auth.uid
            && request.resource.data.limiteChoferes == resource.data.limiteChoferes
            && request.resource.data.owner == resource.data.owner)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choferes'])
            && request.resource.data.choferes.diff(resource.data.choferes).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.choferes.keys().size() <= resource.data.limiteChoferes)
        );
      allow delete: if false;

      match /registros/{regId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/flotas/$(flotaId)).data.owner == request.auth.uid;
        allow create, update: if request.auth != null
                    && request.resource.data.choferUid == request.auth.uid
                    && regId.matches('^' + request.auth.uid + '_.*')
                    && (request.auth.uid in get(/databases/$(database)/documents/flotas/$(flotaId)).data.choferes);
        allow delete: if request.auth != null
                    && resource.data.choferUid == request.auth.uid;
      }
    }
  }
}
